#!/bin/bash
#SBATCH --partition=popgenom,cas,kamiak
#SBATCH --job-name=STAR-index
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=kara.ryan@wsu.edu
#SBATCH --time=7-00:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=6

module add singularity

# Convert gff to gtf
singularity exec -B ${PWD} docker://systemsgenetics/gemmaker \
  gffread \
    /weka/data/lab/kelley/projects/kerry/pmex_reference/GCF_001443325.1_P_mexicana-1.0_genomic_with_mito_sequence.gff \
    -T -o Pmex.gtf

# For compatibility, use the STAR image recommended by GEMmaker
singularity exec -B ${PWD} https://depot.galaxyproject.org/singularity/star:2.7.9a--h9ee0642_0 \
  STAR \
    --runThreadN 6 \
    --runMode genomeGenerate \
    --genomeDir Pmex.indexed \
    --genomeFastaFiles /weka/data/lab/kelley/projects/kerry/pmex_reference/GCF_001443325.1_P_mexicana-1.0_genomic_with_mito_sequence.fa \
    --sjdbGTFfile Pmex.gtf \
    --genomeSAindexNbases 12
